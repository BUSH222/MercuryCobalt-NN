# Optional Docker Compose settings. Defaults work without a .env file.
PORT=8080
BIND_ADDRESS=0.0.0.0
IMAGE_TAG=local
MEMORY_LIMIT=128m
NODE_BUILD_HEAP_MB=1024
TERRAIN_MEMORY_LIMIT=512m

# Required only for the "Advanced (terrain, WGS84)" earth model in Settings.
# Without it the app and every other feature work normally; the terrain
# endpoint just returns a clear "invalid_api_key" error. Get a free key at
# https://opentopography.org/ — never commit the real value.
OPENTOPOGRAPHY_API_KEY=
